page {
  background: #f2f2f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  letter-spacing: 0;
}
.page { padding: 24rpx 24rpx 150rpx; }
.section-title { display: flex; justify-content: space-between; align-items: baseline; gap: 20rpx; margin: 22rpx 4rpx 14rpx; }
.section-title__name { font-size: calc(var(--user-font-size, 30rpx) + 2rpx); font-weight: 600; line-height: 1.3; }
.section-title__meta, .muted { color: #8e8e93; font-size: calc(var(--user-font-size, 30rpx) - 6rpx); line-height: 1.35; }
.card { background: #fff; border: 1rpx solid rgba(60,60,67,.12); border-radius: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.025); }
.tag { display: inline-flex; padding: 4rpx 14rpx; border-radius: 99rpx; background: #e4f3e9; color: #207a4b; font-size: calc(var(--user-font-size, 30rpx) - 6rpx); line-height: 1.4; }
.tag--growth { background: #fff0df; color: #a95e18; }
.fab { position: fixed; right: 30rpx; bottom: 130rpx; width: 96rpx; height: 96rpx; min-width: 96rpx; max-width: 96rpx; box-sizing: border-box; border: 0; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; background: #207a4b; color: transparent; box-shadow: 0 12rpx 30rpx rgba(32,122,75,.28); font-size: 0; line-height: 0; z-index: 5; }
.fab::before, .fab::after { content: ""; position: absolute; left: 50%; top: 50%; border-radius: 99rpx; background: #fff; transform: translate(-50%, -50%); }
.fab::before { width: 38rpx; height: 6rpx; }
.fab::after { width: 6rpx; height: 38rpx; }
.sheet-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(10,16,12,.48); z-index: 20; }
.sheet { width: 100%; max-height: 88vh; overflow-y: auto; padding: 30rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.sheet__title { font-size: 34rpx; font-weight: 600; }
.sheet__close { padding: 8rpx 0 8rpx 28rpx; color: #8e8e93; font-size: 38rpx; }
.field { margin: 20rpx 0; }
.field__label { display: block; margin-bottom: 10rpx; font-size: calc(var(--user-font-size, 30rpx) - 1rpx); font-weight: 500; }
.input, .textarea, .picker { width: 100%; border: 1rpx solid rgba(60,60,67,.12); border-radius: 18rpx; background: #f2f2f7; box-sizing: border-box; font-size: var(--user-font-size, 30rpx); color: #1c1c1e; }
.input { height: 88rpx; min-width: 0; padding: 0 22rpx; line-height: normal; }
.picker { min-height: 88rpx; padding: 22rpx; line-height: 42rpx; }
.textarea { min-height: 180rpx; padding: 20rpx 22rpx; line-height: 1.5; }
.primary-button { width: 100%; height: 92rpx; min-width: 0; min-height: 92rpx; box-sizing: border-box; margin: 22rpx 0 0; padding: 0 24rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: #207a4b; color: #fff; font-size: var(--user-font-size, 30rpx); font-weight: 600; line-height: 1.2; text-align: center; white-space: nowrap; }
.primary-button::after { border: 0; }
.danger-button { width: 100%; height: 92rpx; min-width: 0; min-height: 92rpx; box-sizing: border-box; margin: 14rpx 0 0; padding: 0 24rpx; border-radius: 22rpx; border: 1rpx solid rgba(197,57,41,.22); display: flex; align-items: center; justify-content: center; background: #fff; color: #c53929; font-size: var(--user-font-size, 30rpx); font-weight: 500; line-height: 1.2; text-align: center; white-space: nowrap; }
.danger-button::after { border: 0; }
.danger-button[disabled] { background: #fff; color: rgba(197,57,41,.4); }
.progress { height: 10rpx; margin-top: 8rpx; overflow: hidden; border-radius: 99rpx; background: #e5e5ea; }
.progress__fill { height: 100%; border-radius: inherit; background: #207a4b; }
