<view class="habits-panel">
  <view class="compact-head"><view class="search-box"><text class="search-box__icon">⌕</text><input class="search-input" value="{{searchQuery}}" bindinput="onSearch" placeholder="搜索习惯" cursor-spacing="24" always-embed="{{true}}"/><text class="search-box__clear" wx:if="{{searchQuery}}" bindtap="clearSearch">×</text></view><text class="compact-head__count">{{activeItems.length}} 个进行中</text></view>
  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-row"><view class="filter-chip {{selectedFilter === item.name ? 'filter-chip--active' : ''}}" wx:for="{{filterOptions}}" wx:key="name" data-value="{{item.name}}" bindtap="selectFilter"><text class="filter-chip__dot" style="background:{{item.color}}"></text><text>{{item.name}}</text></view><view class="filter-chip filter-chip--manage" bindtap="openCategoryManager"><text>＋ 管理标签</text></view></view></scroll-view>
  <view class="checkin-list" wx:if="{{activeItems.length}}"><view class="checkin-card card" wx:for="{{activeItems}}" wx:key="_id" data-id="{{item._id}}" bindtap="toggleHabit"><view class="checkin-card__main"><view class="habit-main"><view class="habit-icon" style="background:{{item.categoryColor}}">{{item.categoryInitial}}</view><view class="habit-body"><view class="habit-title-row"><text class="checkin-card__title">{{item.name}}</text></view><view class="progress-head"><text>{{item.periodLabel}}进度</text><text>{{item.periodCount}} / {{item.periodTarget}}</text></view><view class="progress"><view class="progress__fill" style="width:{{item.periodPercent}}%"></view></view></view></view><view class="habit-expanded" wx:if="{{item.expanded}}"><text class="muted checkin-card__desc">{{item.description || '暂无详细说明'}}</text><view class="checkin-card__foot"><text>累计坚持 {{item.currentCount || 0}} 次</text><text>{{item.deadlineText}}</text></view><view class="habit-actions"><button class="timeline-button" data-id="{{item._id}}" catchtap="openDetail">查看坚持时间轴</button><text class="edit-icon" data-id="{{item._id}}" catchtap="openEdit">✎</text></view></view></view></view></view>
  <view class="empty card" wx:else>{{searchQuery ? '没有找到匹配的习惯。' : '还没有习惯，点右下角开始创建。'}}</view>
  <view class="completed-panel card" wx:if="{{completedItems.length}}"><view class="completed-head" bindtap="toggleCompleted"><text>已完成的习惯（{{completedItems.length}}）</text><text>{{showCompleted ? '⌃' : '⌄'}}</text></view><view wx:if="{{showCompleted}}"><view class="completed-row" wx:for="{{completedItems}}" wx:key="_id" data-id="{{item._id}}" bindtap="openDetail"><text>✓ {{item.name}}</text><text class="muted">累计 {{item.currentCount}} 次 ›</text></view></view></view>
  <view class="fab" bindtap="openCreate">＋</view>
  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showSheet}}" bindtap="closeSheet"><view class="sheet" catchtap="stopPropagation"><view class="sheet__head"><text class="sheet__title">{{editingId ? '编辑习惯' : '新建习惯'}}</text><text class="sheet__close" bindtap="closeSheet">×</text></view><view class="field"><text class="field__label">分类标签</text><picker class="picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view>{{categories[categoryIndex] || '请先管理习惯标签'}}</view></picker></view><view class="field"><text class="field__label">习惯名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="例如：练习瑜伽" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="field"><text class="field__label">详细信息</text><textarea class="textarea" value="{{form.description}}" data-field="description" bindinput="onInput" placeholder="写下练习方法、目标或注意事项" adjust-position="{{false}}" cursor-spacing="24" fixed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="frequency-row"><view class="field"><text class="field__label">统计周期</text><picker class="picker" mode="selector" range="{{frequencyOptions}}" range-key="label" value="{{frequencyIndex}}" bindchange="onFrequencyChange"><view>{{frequencyOptions[frequencyIndex].label}}</view></picker></view><view class="field"><text class="field__label">周期目标次数</text><input class="input" type="number" value="{{form.periodTarget}}" data-field="periodTarget" bindinput="onInput" adjust-position="{{false}}" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view></view><view class="field"><text class="field__label">累计目标次数</text><input class="input" type="number" value="{{form.targetCount}}" data-field="targetCount" bindinput="onInput" adjust-position="{{false}}" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="field"><text class="field__label">截止日期（选填）</text><view class="date-row"><picker class="picker date-picker" mode="date" start="{{today}}" value="{{form.deadline}}" bindchange="onDeadlineChange"><view>{{form.deadline || '选择截止日期'}}</view></picker><text class="clear-date" wx:if="{{form.deadline}}" bindtap="clearDeadline">清除</text></view></view><view class="field"><view class="field-label-row"><text class="field__label">参考附件（图片或视频）</text><text class="manage-link" bindtap="chooseReference">{{uploading ? '上传中…' : '添加'}}</text></view><view class="attachment-list"><view class="attachment" wx:for="{{form.attachments}}" wx:key="url"><text>{{item.type === 'video' ? '视频' : '图片'}} {{index + 1}}</text><text class="danger-link" data-index="{{index}}" bindtap="removeAttachment">移除</text></view></view></view><button class="primary-button" bindtap="saveTask" loading="{{saving}}" disabled="{{uploading}}">{{editingId ? '保存修改' : '创建习惯'}}</button><button class="danger-button" wx:if="{{editingId}}" bindtap="deleteEditingTask">删除这个习惯</button></view></view>
  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showCategoryManager}}" bindtap="closeCategoryManager"><view class="sheet" catchtap="stopPropagation"><view class="sheet__head"><text class="sheet__title">管理习惯标签</text><text class="sheet__close" bindtap="closeCategoryManager">×</text></view><view class="category-editor"><input class="input" value="{{categoryDraft}}" bindinput="onCategoryDraft" placeholder="输入新标签名称" adjust-position="{{false}}" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/><button class="category-save" bindtap="saveCategory">{{editingCategoryIndex >= 0 ? '保存' : '新增'}}</button></view><view wx:if="{{recommendedCategories.length}}"><text class="color-label">任务页用过的标签</text><view class="recommend-list"><text wx:for="{{recommendedCategories}}" wx:key="*this" data-name="{{item}}" bindtap="useRecommendedCategory">{{item}}</text></view></view><text class="color-label">选择标签颜色</text><view class="color-palette"><view class="color-dot {{selectedCategoryColor === item ? 'color-dot--active' : ''}}" wx:for="{{colorPalette}}" wx:key="*this" data-color="{{item}}" style="background:{{item}}" bindtap="chooseCategoryColor"></view></view><text class="manage-link" wx:if="{{editingCategoryIndex >= 0}}" bindtap="cancelCategoryEdit">取消编辑</text><view class="category-manage-list"><view class="category-manage-row" wx:for="{{categories}}" wx:key="*this"><text class="tag" style="background:{{categoryColors[item] || '#728077'}};color:#fff">{{item}}</text><view><text class="category-action" data-index="{{index}}" bindtap="editCategory">编辑</text><text class="category-action category-action--delete" data-index="{{index}}" bindtap="deleteCategory">删除</text></view></view></view></view></view>
</view>
