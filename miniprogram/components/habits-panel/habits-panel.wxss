.habits-panel { padding-top: 0; }
.content-tabs { height: 76rpx; margin: 2rpx 0 18rpx; padding: 6rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 6rpx; border-radius: 20rpx; background: #e5e5ea; box-sizing: border-box; }
.content-tab { display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #636366; font-size: 27rpx; font-weight: 500; }
.content-tab--active { background: #fff; color: #1c1c1e; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.08); }
.compact-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18rpx;align-items:center;margin:0 4rpx 10rpx}.compact-head__count{color:#8e8e93;font-size:24rpx;white-space:nowrap}.search-box { height: 58rpx; display: grid; grid-template-columns: 34rpx minmax(0,1fr) 34rpx; align-items: center; margin:0; padding:0; border:0; background:transparent; box-sizing: border-box; }
.search-box__icon,.search-box__clear { color:#8e8e93;font-size:31rpx;text-align:center}.search-input{width:100%;height:58rpx;min-width:0;font-size:27rpx}.checkin-list{display:grid;gap:16rpx}.checkin-card{overflow:hidden}.checkin-card__main{padding:24rpx}.checkin-card__foot,.completed-head,.completed-row,.field-label-row,.date-row,.attachment{display:flex;align-items:center;justify-content:space-between}.habit-main{display:flex;align-items:flex-start;gap:16rpx}.habit-icon{width:42rpx;height:42rpx;flex:0 0 42rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;font-size:22rpx}.habit-body{min-width:0;flex:1}.habit-title-row{display:grid;grid-template-columns:minmax(0,1fr) 52rpx;align-items:center;gap:12rpx}.checkin-card__title{font-size:31rpx;font-weight:600}.detail-arrow{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:#207a4b;color:#fff;font-size:38rpx;line-height:1}.progress-head{display:flex;justify-content:space-between;margin-top:12rpx;color:#8e8e93;font-size:22rpx}.checkin-card__desc{display:block;line-height:1.5}.habit-expanded{margin:16rpx 0 0 58rpx;padding-top:16rpx;border-top:1rpx solid #e5e5ea}.checkin-card__foot{margin-top:14rpx;color:#8e8e93;font-size:23rpx}.tutorial-scroll{width:100%;margin-top:16rpx;white-space:nowrap}.tutorial-row{display:inline-flex;gap:12rpx}.tutorial-item,.tutorial-item image,.tutorial-item video{width:220rpx;height:150rpx;border-radius:16rpx;overflow:hidden;background:#111}.danger-link{color:#c53929}.empty{padding:48rpx 28rpx;color:#8e8e93;text-align:center}.completed-panel{margin-top:20rpx;overflow:hidden}.completed-head,.completed-row{min-height:88rpx;padding:0 22rpx}.completed-row{border-top:1rpx solid #e5e5ea}.date-row{gap:12rpx}.date-picker{flex:1}.clear-date{padding:24rpx;color:#c53929}.attachment-list{display:grid;gap:10rpx}.attachment{min-height:70rpx;padding:0 18rpx;border-radius:16rpx;background:#f2f2f7;font-size:25rpx}
.frequency-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.frequency-row .field{min-width:0}
.filter-scroll{width:100%;margin-bottom:16rpx;white-space:nowrap}.filter-row{display:inline-flex;align-items:center;gap:12rpx;padding:3rpx 4rpx}.filter-chip{height:64rpx;box-sizing:border-box;display:inline-flex;align-items:center;gap:8rpx;padding:0 18rpx;border:1rpx solid #d1d1d6;border-radius:99rpx;background:#fff;color:#636366;font-size:24rpx}.filter-chip--active{border-color:#207a4b;background:#e4f3e9;color:#207a4b;font-weight:500}.filter-chip__dot{width:14rpx;height:14rpx;border-radius:50%}.filter-chip--manage{border-style:dashed;color:#207a4b}.habit-tag{padding:2rpx 8rpx;border:1rpx solid currentColor;border-radius:99rpx;font-size:20rpx}.category-editor{display:grid;grid-template-columns:minmax(0,1fr) 144rpx;gap:12rpx}.category-save{width:144rpx;height:88rpx;margin:0;padding:0;border-radius:18rpx;background:#207a4b;color:#fff;font-size:26rpx;line-height:88rpx}.color-label{display:block;margin:20rpx 0 10rpx;color:#8e8e93;font-size:24rpx}.color-palette{display:flex;flex-wrap:wrap;gap:18rpx}.color-dot{width:48rpx;height:48rpx;box-sizing:border-box;border:6rpx solid #fff;border-radius:50%;box-shadow:0 0 0 1rpx #d1d1d6}.color-dot--active{box-shadow:0 0 0 4rpx #1c1c1e}.recommend-list{display:flex;flex-wrap:wrap;gap:12rpx}.recommend-list text{padding:10rpx 18rpx;border-radius:99rpx;background:#f2f2f7;color:#207a4b;font-size:24rpx}.category-manage-row{display:flex;justify-content:space-between;align-items:center;padding:18rpx 4rpx;border-bottom:1rpx solid #e5e5ea}.category-action{margin-left:24rpx;color:#207a4b;font-size:24rpx}.category-action--delete{color:#c53929}
