.sync-page { padding-top: 20rpx; }
.sync-intro, .cloud-notice, .link-card, .invite-card { padding: 24rpx; }
.sync-intro__title, .link-card__state { display: block; margin-bottom: 8rpx; font-size: 32rpx; font-weight: 500; }
.cloud-notice text { display: block; margin-bottom: 8rpx; }
.scope-card { padding: 0 22rpx; }
.scope-row { min-height: 104rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #e5eae6; }
.scope-row:last-child { border-bottom: 0; }
.scope-row view { min-width: 0; }
.scope-row text { display: block; }
.join-divider { display: flex; align-items: center; justify-content: center; margin: 30rpx 0 18rpx; color: #728077; font-size: 24rpx; }
.sync-primary-button { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; line-height: 1.2; }
.join-row { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) 150rpx; align-items: stretch; gap: 12rpx; box-sizing: border-box; overflow: hidden; }
.join-row .code-input { min-width: 0; }
.join-button, .secondary-button { box-sizing: border-box; margin: 0; border-radius: 18rpx; background: #e4f3e9; color: #207a4b; font-size: 27rpx; white-space: nowrap; }
.join-button { width: 150rpx; height: 88rpx; min-width: 150rpx; max-width: 150rpx; padding: 0; display: block; font-weight: 600; line-height: 88rpx; text-align: center; }
.join-button::after, .secondary-button::after { border: 0; }
.member-list { display: grid; gap: 8rpx; margin-top: 20rpx; }
.member { display: flex; justify-content: space-between; align-items: center; padding-top: 12rpx; border-top: 1rpx solid #e5eae6; }
.invite-card { margin-top: 18rpx; }
.invite-code { display: flex; justify-content: space-between; align-items: center; margin: 10rpx 0; padding: 18rpx; border-radius: 18rpx; background: #f5f6f4; }
.invite-code > text { letter-spacing: 10rpx; color: #207a4b; font-size: 38rpx; font-weight: 500; }
.invite-code button { width: auto; margin: 0; padding: 8rpx 16rpx; background: #fff; color: #207a4b; font-size: 24rpx; }
.secondary-button { width: 100%; height: 92rpx; min-height: 92rpx; margin: 18rpx 0 0; padding: 0 24rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; line-height: 1.2; text-align: center; }
.danger-button { margin-top: 28rpx; }
.danger-button::after { border: 0; }
