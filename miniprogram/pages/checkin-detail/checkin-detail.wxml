<view class="page detail-page" wx:if="{{item}}">
  <view class="hero card"><view class="hero__head"><text class="hero__title">{{item.name}}</text><text class="hero__count">{{periodLabel}} {{periodCount}} / {{item.periodTarget}} 次</text></view><text class="hero__desc">{{item.description || '暂无详细说明'}}</text><view class="habit-stats"><view><text class="habit-stats__number">{{periodCount}}</text><text>{{periodLabel}}已坚持</text></view><view><text class="habit-stats__number">{{item.currentCount || 0}}</text><text>累计坚持</text></view></view><view class="hero__meta"><text>累计目标 {{item.targetCount}} 次</text><text>{{item.deadline ? '截止 ' + item.deadline : '不设截止日期'}}</text></view></view>
  <view class="section-title" wx:if="{{item.attachments.length}}"><text class="section-title__name">跟练资料</text><text class="section-title__meta">{{item.attachments.length}} 个附件</text></view><scroll-view class="media-scroll" scroll-x wx:if="{{item.attachments.length}}"><view class="media-row"><view class="media-card" wx:for="{{item.attachments}}" wx:key="url"><image wx:if="{{item.type !== 'video'}}" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewReference"/><video wx:else src="{{item.url}}" controls show-center-play-btn/></view></view></scroll-view>
  <button class="primary-button checkin-button" bindtap="openCheckin">＋ 打卡一次</button>
  <view class="section-title"><text class="section-title__name">坚持时间轴</text><text class="section-title__meta">{{logs.length}} 条</text></view><view class="timeline" wx:if="{{logs.length}}"><view class="timeline-item" wx:for="{{logs}}" wx:key="_id"><view class="timeline-axis"><view class="timeline-dot"></view><view class="timeline-line" wx:if="{{index < logs.length - 1}}"></view></view><view class="log-card card"><view class="log-head"><text class="log-index">第 {{logs.length - index}} 次坚持</text><text class="muted">{{item.displayDate}}</text></view><text class="log-note">{{item.note || '这次打卡没有填写心得。'}}</text><view class="photo-grid" wx:if="{{item.photos.length}}"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.photos}}" bindtap="previewPhoto"/></view><text class="delete-log" data-id="{{item._id}}" bindtap="deleteLog">删除这次记录</text></view></view></view><view class="empty card" wx:else>还没有打卡记录，完成第一次打卡吧。</view>
  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showSheet}}" bindtap="closeSheet"><view class="sheet" catchtap="stopPropagation"><view class="sheet__head"><text class="sheet__title">记录这次打卡</text><text class="sheet__close" bindtap="closeSheet">×</text></view><view class="field"><text class="field__label">心得或完成内容（选填）</text><textarea class="textarea" value="{{form.note}}" bindinput="onNote" placeholder="写下你做了什么、有什么感受" adjust-position="{{false}}" cursor-spacing="24" fixed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="field"><view class="field-head"><text class="field__label">照片（选填）</text><text class="add-photo" bindtap="choosePhotos">{{uploading ? '上传中…' : '添加照片'}}</text></view><view class="photo-grid"><view class="photo-wrap" wx:for="{{form.photos}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><text data-index="{{index}}" bindtap="removePhoto">×</text></view></view></view><button class="primary-button" bindtap="saveCheckin" loading="{{saving}}" disabled="{{uploading}}">完成打卡</button></view></view>
</view>
