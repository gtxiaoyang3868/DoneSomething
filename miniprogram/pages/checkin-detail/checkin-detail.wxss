.detail-page{padding-top:24rpx}.hero{padding:28rpx}.hero__head,.hero__meta,.log-head,.field-head{display:flex;align-items:center;justify-content:space-between}.hero__title{font-size:36rpx;font-weight:650}.hero__count{color:#207a4b;font-weight:600}.hero__desc{display:block;margin:18rpx 0;color:#636366;line-height:1.55}.hero__meta{margin-top:12rpx;color:#8e8e93;font-size:24rpx}.media-scroll{width:100%;white-space:nowrap}.media-row{display:inline-flex;gap:14rpx;padding:2rpx}.media-card,.media-card image,.media-card video{width:260rpx;height:180rpx;border-radius:20rpx;overflow:hidden;background:#000}.checkin-button{margin-top:24rpx}.log-list{display:grid;gap:16rpx}.log-card{padding:24rpx}.log-index{font-weight:600}.log-note{display:block;margin:16rpx 0;line-height:1.55}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.photo-grid image,.photo-wrap{width:100%;height:190rpx;border-radius:16rpx;overflow:hidden}.photo-wrap{position:relative}.photo-wrap image{height:100%}.photo-wrap text{position:absolute;top:6rpx;right:6rpx;width:40rpx;height:40rpx;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;text-align:center;line-height:38rpx}.delete-log{display:block;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #e5e5ea;color:#c53929;font-size:24rpx}.empty{padding:48rpx 28rpx;color:#8e8e93;text-align:center}.add-photo{color:#207a4b;font-size:25rpx}
.habit-stats{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin:22rpx 0}.habit-stats>view{padding:18rpx;border-radius:18rpx;background:#eaf5ee;color:#207a4b;text-align:center}.habit-stats text{display:block;font-size:23rpx}.habit-stats__number{margin-bottom:4rpx;font-size:38rpx!important;font-weight:650}
