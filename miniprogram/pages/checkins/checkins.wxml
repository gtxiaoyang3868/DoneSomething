<view class="page checkins-page">
  <view class="section-title"><text class="section-title__name">打卡任务</text><text class="section-title__meta">{{activeItems.length}} 个进行中</text></view>
  <view class="search-box"><text class="search-box__icon">⌕</text><input class="search-input" value="{{searchQuery}}" bindinput="onSearch" placeholder="搜索打卡名称或说明" cursor-spacing="24" always-embed="{{true}}"/><text class="search-box__clear" wx:if="{{searchQuery}}" bindtap="clearSearch">×</text></view>
  <view class="checkin-list" wx:if="{{activeItems.length}}"><view class="checkin-card card" wx:for="{{activeItems}}" wx:key="_id"><view class="checkin-card__main" data-id="{{item._id}}" bindtap="openDetail"><view class="checkin-card__head"><text class="checkin-card__title">{{item.name}}</text><text class="checkin-card__count">{{item.currentCount || 0}} / {{item.targetCount}} 次</text></view><text class="muted checkin-card__desc">{{item.description || '暂无详细说明'}}</text><view class="progress"><view class="progress__fill" style="width:{{item.percent}}%"></view></view><view class="checkin-card__foot"><text>{{item.percent}}%</text><text>{{item.deadlineText}}</text></view></view><view class="checkin-card__actions"><text data-id="{{item._id}}" bindtap="openEdit">编辑</text><text class="danger-link" data-id="{{item._id}}" bindtap="deleteTask">删除</text></view></view></view>
  <view class="empty card" wx:else>{{searchQuery ? '没有找到匹配的打卡任务。' : '还没有打卡任务，点右下角开始创建。'}}</view>
  <view class="completed-panel card" wx:if="{{completedItems.length}}"><view class="completed-head" bindtap="toggleCompleted"><text>已完成的打卡（{{completedItems.length}}）</text><text>{{showCompleted ? '⌃' : '⌄'}}</text></view><view wx:if="{{showCompleted}}"><view class="completed-row" wx:for="{{completedItems}}" wx:key="_id" data-id="{{item._id}}" bindtap="openDetail"><text>✓ {{item.name}}</text><text class="muted">{{item.currentCount}} / {{item.targetCount}} 次 ›</text></view></view></view>
  <view class="fab" bindtap="openCreate">＋</view>
  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showSheet}}" bindtap="closeSheet"><view class="sheet" catchtap="stopPropagation"><view class="sheet__head"><text class="sheet__title">{{editingId ? '编辑打卡任务' : '新建打卡任务'}}</text><text class="sheet__close" bindtap="closeSheet">×</text></view><view class="field"><text class="field__label">打卡名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="例如：每天练习瑜伽" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="field"><text class="field__label">详细信息</text><textarea class="textarea" value="{{form.description}}" data-field="description" bindinput="onInput" placeholder="写下练习方法、目标或注意事项" adjust-position="{{false}}" cursor-spacing="24" fixed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="field"><text class="field__label">目标次数</text><input class="input" type="number" value="{{form.targetCount}}" data-field="targetCount" bindinput="onInput" adjust-position="{{false}}" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange"/></view><view class="field"><text class="field__label">截止日期（选填）</text><view class="date-row"><picker class="picker date-picker" mode="date" start="{{today}}" value="{{form.deadline}}" bindchange="onDeadlineChange"><view>{{form.deadline || '选择截止日期'}}</view></picker><text class="clear-date" wx:if="{{form.deadline}}" bindtap="clearDeadline">清除</text></view></view><view class="field"><view class="field-label-row"><text class="field__label">参考附件（图片或视频）</text><text class="manage-link" bindtap="chooseReference">{{uploading ? '上传中…' : '添加'}}</text></view><view class="attachment-list"><view class="attachment" wx:for="{{form.attachments}}" wx:key="url"><text>{{item.type === 'video' ? '视频' : '图片'}} {{index + 1}}</text><text class="danger-link" data-index="{{index}}" bindtap="removeAttachment">移除</text></view></view></view><button class="primary-button" bindtap="saveTask" loading="{{saving}}" disabled="{{uploading}}">{{editingId ? '保存修改' : '创建打卡任务'}}</button></view></view>
</view>
