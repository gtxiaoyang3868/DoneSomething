.checkins-page { padding-top: 12rpx; }
.search-box { height: 76rpx; display: grid; grid-template-columns: 44rpx minmax(0,1fr) 44rpx; align-items: center; margin-bottom: 16rpx; padding: 0 14rpx; border: 1rpx solid rgba(60,60,67,.12); border-radius: 20rpx; background: #fff; box-sizing: border-box; }
.search-box__icon,.search-box__clear { color:#8e8e93; font-size:34rpx; text-align:center; }.search-input{width:100%;height:72rpx;min-width:0;font-size:27rpx}.checkin-list{display:grid;gap:16rpx}.checkin-card{overflow:hidden}.checkin-card__main{padding:24rpx}.checkin-card__head,.checkin-card__foot,.checkin-card__actions,.completed-head,.completed-row,.field-label-row,.date-row,.attachment{display:flex;align-items:center;justify-content:space-between}.checkin-card__title{font-size:31rpx;font-weight:600}.checkin-card__count{color:#207a4b;font-weight:600}.checkin-card__desc{display:block;margin:10rpx 0}.checkin-card__foot{margin-top:10rpx;color:#8e8e93;font-size:23rpx}.checkin-card__actions{padding:18rpx 24rpx;border-top:1rpx solid #e5e5ea;color:#207a4b}.danger-link{color:#c53929}.empty{padding:48rpx 28rpx;color:#8e8e93;text-align:center}.completed-panel{margin-top:20rpx;overflow:hidden}.completed-head,.completed-row{min-height:88rpx;padding:0 22rpx}.completed-row{border-top:1rpx solid #e5e5ea}.date-row{gap:12rpx}.date-picker{flex:1}.clear-date{padding:24rpx;color:#c53929}.attachment-list{display:grid;gap:10rpx}.attachment{min-height:70rpx;padding:0 18rpx;border-radius:16rpx;background:#f2f2f7;font-size:25rpx}
