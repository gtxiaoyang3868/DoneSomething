.community-page{padding-top:20rpx}.community-tabs{height:76rpx;padding:6rpx;display:grid;grid-template-columns:1fr 1fr;gap:6rpx;border-radius:20rpx;background:#e5e5ea;box-sizing:border-box}.community-tab{display:flex;align-items:center;justify-content:center;border-radius:16rpx;color:#636366;font-size:27rpx;font-weight:500}.community-tab--active{background:#fff;color:#1c1c1e;box-shadow:0 2rpx 8rpx rgba(0,0,0,.08)}.community-hero{margin-top:24rpx;padding:50rpx 30rpx;text-align:center}.community-hero__icon{width:96rpx;height:96rpx;margin:0 auto 22rpx;border-radius:30rpx;display:flex;align-items:center;justify-content:center;background:#e4f3e9;color:#207a4b;font-size:52rpx}.community-hero__title{display:block;margin-bottom:12rpx;font-size:34rpx;font-weight:650}.community-hero .muted{display:block;line-height:1.6}.privacy-note{margin-top:28rpx;padding:0 8rpx}.privacy-note>text{display:block;margin-bottom:8rpx}
