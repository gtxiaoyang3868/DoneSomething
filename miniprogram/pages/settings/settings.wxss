.settings-page { padding-top: 20rpx; }
.profile-head { display: flex; align-items: center; gap: 22rpx; padding: 26rpx; }
.avatar-button { width: 108rpx; min-width: 108rpx; max-width: 108rpx; height: 108rpx; min-height: 108rpx; max-height: 108rpx; flex: 0 0 108rpx; box-sizing: border-box; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 999rpx; background: #e4f3e9; color: #207a4b; font-size: 40rpx; line-height: 1; }
.avatar-button::after { border: 0; }
.avatar-button image { width: 100%; height: 100%; }
.profile-head__body { min-width: 0; flex: 1; }
.profile-head__name { display: block; margin-bottom: 7rpx; overflow: hidden; font-size: 34rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.profile-head__copy { display: block; margin-top: 5rpx; color: #728077; font-size: 24rpx; }
.font-slider { padding: 24rpx 20rpx 16rpx; }
.font-slider__preview { display: grid; grid-template-columns: 48rpx 1fr 48rpx; align-items: center; gap: 10rpx; text-align: center; }
.font-slider__small { color: #728077; font-size: 24rpx; }
.font-slider__large { font-size: 34rpx; }
.font-slider__scale { display: flex; justify-content: space-between; padding: 0 12rpx; color: #728077; font-size: 22rpx; }
.profile-form { padding: 6rpx 24rpx 26rpx; }
.privacy-note { display: block; padding: 18rpx 6rpx; color: #728077; text-align: center; font-size: 23rpx; }
.field-tip { display: block; margin-top: 8rpx; color: #728077; font-size: 22rpx; }
.account-sync-entry { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; padding: 24rpx; }
.account-sync-entry > view { min-width: 0; }
.account-sync-entry__title { display: block; margin-bottom: 6rpx; font-weight: 500; }
.account-sync-entry__arrow { flex: 0 0 auto; color: #207a4b; font-size: 42rpx; }
