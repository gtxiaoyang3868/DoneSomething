.stats-page { padding-top: 18rpx; }
.stats-toolbar { display: block; margin: 0 4rpx 16rpx; }
.stats-toolbar__title { display: block; margin-bottom: 12rpx; color: #728077; font-size: calc(var(--user-font-size, 30rpx) - 6rpx); line-height: 1.4; white-space: nowrap; }
.toolbar-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; width: 100%; }
.export-button { width: 100%; min-width: 0; margin: 0; padding: 12rpx 10rpx; border: 1rpx solid #e5eae6; border-radius: 16rpx; background: #fff; color: #17211b; font-size: 23rpx; line-height: 1.5; white-space: nowrap; }
.export-button::after { border: 0; }
.settings-button { width: 100%; min-width: 0; margin: 0; padding: 12rpx 10rpx; border: 1rpx solid #e5eae6; border-radius: 16rpx; background: #fff; color: #17211b; font-size: 23rpx; line-height: 1.5; white-space: nowrap; }
.settings-button::after { border: 0; }
.period-tabs { display: grid; grid-template-columns: repeat(3, 1fr); padding: 6rpx; border-radius: 20rpx; background: #e5eae6; }
.period-tab { padding: 14rpx 6rpx; border-radius: 15rpx; color: #728077; text-align: center; font-size: 24rpx; }
.period-tab--active { background: #fff; color: #17211b; font-weight: 500; }
.custom-range { margin-top: 14rpx; padding: 20rpx; }
.date-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12rpx; align-items: end; }
.date-picker { margin-top: 7rpx; padding: 14rpx; border-radius: 14rpx; background: #f5f6f4; font-size: 23rpx; }
.date-to { padding-bottom: 14rpx; color: #728077; }
.range-button { margin-top: 16rpx; font-size: 24rpx; }
.achievement { margin-top: 16rpx; padding: 26rpx; border-radius: 28rpx; background: linear-gradient(135deg, #207a4b, #4aa873); color: #fff; }
.achievement__head { display: flex; justify-content: space-between; }
.achievement__title, .achievement__copy { display: block; }
.achievement__title { font-size: 33rpx; font-weight: 500; }
.achievement__copy { margin-top: 6rpx; font-size: 22rpx; opacity: .84; }
.achievement__medal { font-size: 48rpx; }
.stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 24rpx; }
.stat { padding: 14rpx; border-radius: 18rpx; background: rgba(255,255,255,.15); font-size: 20rpx; }
.stat:active { background: rgba(255,255,255,.25); }
.stat__value { display: block; font-size: 34rpx; font-weight: 500; }
.achievement__highlight { display: block; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,.22); font-size: 22rpx; line-height: 1.45; opacity: .9; }
.chart { margin-top: 16rpx; padding: 22rpx; }
.chart__head { display: flex; justify-content: space-between; }
.bars { height: 210rpx; display: grid; grid-template-columns: repeat(7, 1fr); align-items: end; gap: 12rpx; margin-top: 20rpx; border-bottom: 1rpx solid #e5eae6; }
.bar-item { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 8rpx; color: #728077; font-size: 20rpx; }
.bar-count { color: #636366; font-size: 20rpx; }
.bar-column { width: 28rpx; min-height: 8rpx; border-radius: 12rpx 12rpx 3rpx 3rpx; background: #e4f3e9; }
.bar-column--last { background: #207a4b; }
.breakdown-head { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; margin-top: 30rpx; }
.breakdown-title { font-size: 28rpx; font-weight: 600; }
.breakdown-tabs { display: grid; grid-template-columns: 1fr 1fr; padding: 4rpx; border-radius: 14rpx; background: #e9e9ee; }
.breakdown-tab { min-width: 92rpx; padding: 8rpx 12rpx; border-radius: 11rpx; color: #8e8e93; text-align: center; font-size: 22rpx; }
.breakdown-tab--active { background: #fff; color: #1c1c1e; box-shadow: 0 1rpx 5rpx rgba(0,0,0,.08); font-weight: 500; }
.category-list { margin-top: 14rpx; overflow: hidden; border: 1rpx solid rgba(60,60,67,.10); border-radius: 20rpx; background: #fff; }
.category-row { position: relative; min-height: 112rpx; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 18rpx; box-sizing: border-box; }
.category-row::after { content: ""; position: absolute; left: 86rpx; right: 0; bottom: 0; height: 1rpx; background: rgba(60,60,67,.12); }
.category-row:last-child::after { display: none; }
.category-row:active { background: #f2f2f7; }
.category-icon { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 24rpx; font-weight: 600; line-height: 1; }
.category-content { min-width: 0; flex: 1; }
.category-main { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; }
.category-labels { min-width: 0; }
.category-name { display: block; min-width: 0; overflow: hidden; color: #1c1c1e; font-size: 26rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.category-subtitle { display: block; margin-top: 2rpx; color: #8e8e93; font-size: 20rpx; }
.category-count { flex: 0 0 auto; color: #8e8e93; font-size: 24rpx; white-space: nowrap; }
.category-progress { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 99rpx; background: #e5e5ea; }
.category-progress__fill { height: 100%; border-radius: inherit; background: #207a4b; }
.category-chevron { flex: 0 0 auto; color: #c7c7cc; font-size: 36rpx; line-height: 1; }
.breakdown-empty { margin-top: 14rpx; padding: 30rpx 20rpx; border-radius: 18rpx; background: #f2f2f7; color: #8e8e93; text-align: center; font-size: 23rpx; line-height: 1.45; }
.export-option { display: flex; gap: 18rpx; align-items: center; margin: 14rpx 0; padding: 22rpx; border: 1rpx solid #e5eae6; border-radius: 22rpx; background: #f5f6f4; }
.export-option--active { border-color: #207a4b; background: #e4f3e9; }
.export-option__icon { width: 62rpx; height: 62rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: #fff; color: #207a4b; }
.export-option__title { display: block; font-weight: 500; }
.export-help { display: block; margin-top: 12rpx; color: #728077; font-size: 21rpx; }
