<view class="page detail-page" style="--user-font-size:{{fontSize}}rpx;font-size:{{fontSize}}rpx" wx:if="{{task}}">
  <view class="task-overview card">
    <view class="task-overview__head"><text class="task-overview__name">{{task.name}}</text><view class="task-overview__actions"><text class="tag" style="background:{{task.categoryColor}};color:#fff">{{task.category}}</text><button class="edit-button" bindtap="openTaskEditor" aria-label="编辑任务">✎</button></view></view>
    <text class="task-overview__desc">{{task.description || '暂无任务描述'}}</text>
    <view class="progress-head"><text>当前进度</text><text>{{task.progress}}%</text></view>
    <view class="progress"><view class="progress__fill" style="width:{{task.progress}}%;background:{{task.progressColor}}"></view></view>
    <view class="overview-stats"><view><text class="overview-stats__value">{{executionDays}}</text><text class="muted">执行天数</text></view><view><text class="overview-stats__value">{{records.length}}</text><text class="muted">事件记录</text></view><view><text class="overview-stats__value">{{lastRecordDate || '—'}}</text><text class="muted">最近记录</text></view></view>
  </view>

  <view class="section-title"><text class="section-title__name">干过的事情</text><text class="section-title__meta">点击记录可编辑</text></view>
  <view class="timeline" wx:if="{{records.length}}"><view class="timeline-item" wx:for="{{records}}" wx:key="_id" data-id="{{item._id}}" bindtap="openRecordEditor"><view class="timeline-dot"></view><view class="timeline-card card"><view class="timeline-card__head"><text>{{item.title}}</text><text class="muted">{{item.recordDate}}</text></view><text class="timeline-card__desc" wx:if="{{item.description}}">{{item.description}}</text><text class="timeline-card__progress" wx:if="{{item.progressAfter !== null && item.progressAfter !== undefined}}">完成度更新至 {{item.progressAfter}}%</text></view></view></view>
  <view class="empty card" wx:else>这个任务还没有事件记录。</view>
  <view class="fab" bindtap="openNewRecord" aria-label="新增任务记录">＋</view>

  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showTaskEditor}}" bindtap="closeEditors"><view class="sheet" catchtap="stopPropagation"><view class="sheet__head"><text class="sheet__title">编辑任务详情</text><text class="sheet__close" bindtap="closeEditors">×</text></view><view class="field"><text class="field__label">分类标签</text><picker class="picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view>{{categories[categoryIndex]}}</view></picker></view><view class="field"><text class="field__label">任务名称</text><input class="input" value="{{taskForm.name}}" data-field="name" bindinput="onTaskInput" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /></view><view class="field"><text class="field__label">任务详情</text><textarea class="textarea" value="{{taskForm.description}}" data-field="description" bindinput="onTaskInput" adjust-position="{{false}}" cursor-spacing="24" fixed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /></view><view class="field"><view class="range-head"><text class="field__label">当前进度</text><text>{{taskForm.progress}}%</text></view><slider value="{{taskForm.progress}}" min="0" max="100" activeColor="{{taskFormProgressColor}}" bindchanging="onTaskProgress" bindchange="onTaskProgress" /></view><button class="primary-button" bindtap="saveTask" loading="{{saving}}">保存任务详情</button><button class="danger-button" bindtap="deleteTask" disabled="{{saving}}">删除任务</button></view></view>

  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showRecordEditor}}" bindtap="closeEditors"><view class="sheet" catchtap="stopPropagation"><view class="sheet__head"><text class="sheet__title">{{editingRecordId ? '编辑事件记录' : '新增事件记录'}}</text><text class="sheet__close" bindtap="closeEditors">×</text></view><view class="field"><text class="field__label">记录日期</text><picker class="picker" mode="date" value="{{recordForm.recordDate}}" end="{{today}}" bindchange="onRecordDate"><view>{{recordForm.recordDate}}</view></picker></view><view class="field"><text class="field__label">做了什么</text><input class="input" value="{{recordForm.title}}" data-field="title" bindinput="onRecordInput" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /></view><view class="field"><text class="field__label">内容描述</text><textarea class="textarea" value="{{recordForm.description}}" data-field="description" bindinput="onRecordInput" adjust-position="{{false}}" cursor-spacing="24" fixed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /></view><view class="field"><view class="range-head"><text class="field__label">任务完成度更新至</text><text>{{recordForm.progressAfter}}%</text></view><slider value="{{recordForm.progressAfter}}" min="0" max="100" activeColor="{{recordProgressColor}}" bindchanging="onRecordProgress" bindchange="onRecordProgress" /></view><button class="primary-button" bindtap="saveRecord" loading="{{saving}}">{{editingRecordId ? '保存记录修改' : '保存事件记录'}}</button><button class="danger-button" wx:if="{{editingRecordId}}" bindtap="deleteRecord" disabled="{{saving}}">删除这条记录</button></view></view>
</view>
