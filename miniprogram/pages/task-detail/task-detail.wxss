.detail-page { padding-top: 20rpx; }
.task-overview { padding: 26rpx; }
.task-overview__head, .progress-head, .range-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; }
.task-overview__name { min-width: 0; flex: 1; font-size: calc(var(--user-font-size, 30rpx) + 4rpx); font-weight: 600; line-height: 1.3; }
.task-overview__actions { flex: 0 0 auto; display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; margin-left: auto; }
.task-overview__actions .tag { flex: 0 0 auto; white-space: nowrap; }
.edit-button { width: 62rpx; min-width: 62rpx; max-width: 62rpx; height: 62rpx; margin: 0; padding: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e4f3e9; color: #207a4b; font-size: 31rpx; line-height: 1; }
.edit-button::after { border: 0; }
.task-overview__desc { display: block; margin-top: 12rpx; color: #8e8e93; line-height: 1.45; }
.progress-head { margin-top: 22rpx; color: #728077; font-size: 24rpx; }
.overview-stats { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e5eae6; }
.overview-stats > view { text-align: center; }
.overview-stats__value { display: block; margin-bottom: 4rpx; color: #207a4b; font-size: 31rpx; font-weight: 500; }
.timeline { padding-left: 20rpx; }
.timeline-item { position: relative; padding: 0 0 16rpx 26rpx; border-left: 2rpx solid #dce7df; }
.timeline-dot { position: absolute; left: -9rpx; top: 24rpx; width: 16rpx; height: 16rpx; border: 2rpx solid #fff; border-radius: 50%; background: #207a4b; }
.timeline-card { padding: 20rpx; }
.timeline-card__head { display: flex; justify-content: space-between; gap: 14rpx; }
.timeline-card__head > text:first-child { font-weight: 500; }
.timeline-card__desc { display: block; margin-top: 7rpx; color: #728077; line-height: 1.4; }
.timeline-card__progress { display: block; margin-top: 10rpx; color: #207a4b; font-size: 24rpx; }
.empty { padding: 50rpx 24rpx; color: #728077; text-align: center; }

.status-button { width: 100%; height: 78rpx; margin: 20rpx 0 0; border: 0; border-radius: 18rpx; background: #207a4b; color: #fff; font-size: 26rpx; font-weight: 600; line-height: 78rpx; }
.status-button::after { border: 0; }
.status-button--completed { background: #f2f2f7; color: #207a4b; }
