<view class="page tasks-page" style="--user-font-size:{{fontSize}}rpx;font-size:{{fontSize}}rpx">
  <view class="section-title"><text class="section-title__name">进行中的任务</text><text class="section-title__meta">{{tasks.length}} 个项目</text></view>
  <view class="count-rule">ⓘ 点击任务进入详情；执行天数只统计有记录的日期，同一天计 1 天</view>
  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-row"><view class="filter-chip filter-chip--manage" bindtap="openCategoryManager"><text class="filter-chip__plus">＋</text><text>管理标签</text></view><view class="filter-chip {{selectedFilter === item.name ? 'filter-chip--active' : ''}}" wx:for="{{filterOptions}}" wx:key="name" data-value="{{item.name}}" bindtap="selectFilter"><text class="filter-chip__dot" style="background:{{item.color}}"></text><text>{{item.name}}</text></view></view></scroll-view>
  <view class="task-list">
    <view class="task-card card" wx:for="{{tasks}}" wx:key="_id" data-id="{{item._id}}" bindtap="openTaskDetail">
      <view class="task-card__icon" style="background:{{item.categoryColor}}">{{item.categoryInitial}}</view>
      <view class="task-card__body">
        <view class="task-title"><text class="task-title__name">{{item.name}}</text><text class="task-enter">›</text></view>
        <text class="task-card__desc">{{item.description}}</text>
        <view class="progress-head"><text>当前进度</text><text>{{item.progress}}%</text></view>
        <view class="progress"><view class="progress__fill" style="width:{{item.progress}}%;background:{{item.progressColor}}"></view></view>
        <view class="task-meta"><text class="task-meta__days">▣ 已执行 <text>{{item.executionDays}} 天</text></text><text class="muted">{{item.lastActiveText}}</text></view>
      </view>
    </view>
  </view>
  <view class="fab" bindtap="openSheet" aria-label="新建任务">＋</view>

  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showSheet}}" bindtap="closeSheet">
    <view class="sheet" catchtap="stopPropagation">
      <view class="sheet__head"><text class="sheet__title">{{editingId ? '编辑任务' : '新建任务'}}</text><text class="sheet__close" bindtap="closeSheet">×</text></view>
      <view class="field"><view class="field-label-row"><text class="field__label">分类标签</text><text class="manage-link" bindtap="openCategoryManager">管理标签</text></view><picker class="picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view>{{categories[categoryIndex] || '请先新增标签'}}</view></picker></view>
      <view class="field"><text class="field__label">任务名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="例如：微信小程序改版" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /></view>
      <view class="field"><text class="field__label">内容描述</text><textarea class="textarea" value="{{form.description}}" data-field="description" bindinput="onInput" placeholder="说明项目目标和范围" adjust-position="{{false}}" cursor-spacing="24" fixed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /></view>
      <view class="field" wx:if="{{editingId}}"><view class="range-head"><text class="field__label">当前进度</text><text>{{form.progress}}%</text></view><slider value="{{form.progress}}" min="0" max="100" activeColor="#207a4b" bindchange="onProgressChange" /></view>
      <button class="primary-button" bindtap="saveTask" loading="{{saving}}">{{editingId ? '保存修改' : '创建任务'}}</button>
    </view>
  </view>

  <view class="sheet-mask" style="bottom:{{keyboardHeight}}px" wx:if="{{showCategoryManager}}" bindtap="closeCategoryManager">
    <view class="sheet category-sheet" catchtap="stopPropagation">
      <view class="sheet__head"><text class="sheet__title">管理分类标签</text><text class="sheet__close" bindtap="closeCategoryManager">×</text></view>
      <view class="category-editor"><input class="input" value="{{categoryDraft}}" bindinput="onCategoryDraft" placeholder="输入新标签名称" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" bindkeyboardheightchange="onKeyboardHeightChange" /><button class="category-save" bindtap="saveCategory">{{editingCategoryIndex >= 0 ? '保存' : '新增'}}</button></view>
      <text class="color-label">选择标签颜色</text><view class="color-palette"><view class="color-dot {{selectedCategoryColor === item ? 'color-dot--active' : ''}}" wx:for="{{colorPalette}}" wx:key="*this" data-color="{{item}}" style="background:{{item}}" bindtap="chooseCategoryColor"></view></view>
      <text class="manage-link" wx:if="{{editingCategoryIndex >= 0}}" bindtap="cancelCategoryEdit">取消编辑</text>
      <view class="category-manage-list"><view class="category-manage-row" wx:for="{{categories}}" wx:key="*this"><text class="tag" style="background:{{categoryColors[item] || '#728077'}};color:#fff">{{item}}</text><view><text class="category-action" data-index="{{index}}" bindtap="editCategory">编辑</text><text class="category-action category-action--delete" data-index="{{index}}" bindtap="deleteCategory">删除</text></view></view></view>
    </view>
  </view>
</view>
